# =========================================
# YONYWOOD BACKEND — Variables d'environnement (Template)
# Copiez ce fichier vers .env et renseignez les valeurs
# =========================================

# Serveur
NODE_ENV=development
PORT=3001

# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/yonywood_db?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# CORS - URL du front-end
CORS_ORIGIN=http://localhost:5173

# (Optionnel) Stockage média
GCS_BUCKET_NAME=yonywood-media
GCS_PROJECT_ID=your-gcp-project-id
